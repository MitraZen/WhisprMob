{
  "name": "whispr-mobile",
  "version": "1.2.17",
  "description": "Whispr - Anonymous messaging and mood-based connections",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start --port=8081",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:performance": "jest --testPathPattern=performance",
    "test:notifications": "jest --testPathPattern=notification",
    "test:chat": "jest --testPathPattern=ChatScreen",
    "test:notes": "jest --testPathPattern=WhisprComposeScreen",
    "test:services": "jest --testPathPattern=services",
    "test:all": "npm run test && npm run test:integration && npm run test:performance",
    "test:debug": "set DEBUG_TESTS=true && npm test",
    "test:integration:debug": "set DEBUG_TESTS=true && npm run test:integration",
    "test:notifications:debug": "set DEBUG_TESTS=true && npm run test:notifications",
    "test:chat:debug": "set DEBUG_TESTS=true && npm run test:chat",
    "test:notes:debug": "set DEBUG_TESTS=true && npm run test:notes",
    "test:notification-suite": "npm run test:notifications && npm run test:chat && npm run test:notes && npm run test:services",
    "test:notification-suite:debug": "set DEBUG_TESTS=true && npm run test:notification-suite",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/datetimepicker": "^8.4.5",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "^2.11.2",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "@supabase/supabase-js": "^2.75.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.2",
    "crypto-js": "^4.2.0",
    "lottie-react-native": "^7.3.4",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-animatable": "^1.3.3",
    "react-native-audio-recorder": "^0.0.8",
    "react-native-dotenv": "^3.4.11",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keychain": "^8.1.3",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal": "^13.0.1",
    "react-native-paper": "^5.11.6",
    "react-native-push-notification": "^8.1.1",
    "react-native-sound": "^0.12.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.3.0",
    "socket.io-client": "^4.7.2",
    "url": "^0.11.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/eslint-config": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/crypto-js": "^4.2.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}

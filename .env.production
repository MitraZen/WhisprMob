# Google Sign-In Configuration
# Default environment (used when no specific .env file is loaded)
# For development, this should match .env.development

# Web OAuth Client ID (Required for React Native Google Sign-In)
# This is the SAME for both debug and production builds
GOOGLE_SIGNIN_WEB_CLIENT_ID=333572988445-e3n45j843hcmc8ck19bbqnhe5i9rthne.apps.googleusercontent.com

# iOS OAuth Client ID (optional, only if supporting iOS)
GOOGLE_SIGNIN_IOS_CLIENT_ID=